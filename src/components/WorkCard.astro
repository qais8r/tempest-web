---
import { authorNames, url, imageSrcset, type Work } from '../lib/content';
import Icon from './Icon.astro';
interface Props {
  work: Work;
}
const { work } = Astro.props;
const artwork = work.artworks[0];
---

<article class="work-card">
  <a
    class:list={['work-card-link', { 'has-artwork': artwork }]}
    href={url(`/works/${work.slug}/`)}
    data-work-transition={work.slug}
    data-work-transition-context="card"
  >
    <div class="work-card-copy">
      <span class="eyebrow accent">{work.category}</span><h3
        data-work-transition-work={work.slug}
        data-work-transition-context="card"
        data-work-transition-part="title"
      >
        {work.title}
      </h3><p class="byline">
        by <span
          data-work-transition-work={work.slug}
          data-work-transition-context="card"
          data-work-transition-part="author">{authorNames(work)}</span
        >
      </p>{work.excerpt && <p class="work-excerpt">{work.excerpt}</p>}
      {
        work.recordings.length > 0 && (
          <span class="audio-hint">
            <Icon name="headphones" size={13} /> With audio
          </span>
        )
      }
    </div>
    {
      artwork && (
        <img
          class="work-thumb"
          src={url(artwork.thumbnailSources?.[0].src || artwork.image)}
          srcset={imageSrcset(artwork.thumbnailSources)}
          sizes="(max-width: 720px) 7.2rem, (max-width: 1180px) 6.5rem, 8rem"
          width="128"
          height="128"
          alt=""
          loading="lazy"
        />
      )
    }
  </a>
</article>
