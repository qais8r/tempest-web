---
import Site from '../../layouts/Site.astro';
import Icon from '../../components/Icon.astro';
import {
  works,
  authorsFor,
  issueUrl,
  readerUrl,
  url,
  prose,
  poetry,
  initials,
  isPoetry,
  imageSrcset,
} from '../../lib/content';
export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props;
const workAuthors = authorsFor(work);
const moreByAuthors = workAuthors
  .map((author) => ({
    author,
    works: works
      .filter((candidate) => candidate.slug !== work.slug && candidate.authors.includes(author.slug))
      .slice(0, 3),
  }))
  .filter(({ works }) => works.length > 0);
---

<Site title={work.title} description={work.excerpt}
  ><main id="main" class="work-page site-main">
    <a class="breadcrumb" href={issueUrl(work.issue)}>← The {work.issue} issue</a>
    <header class="work-header">
      <div class="eyebrow accent">{work.category} <i>·</i> {work.issue}</div><h1
        data-work-transition-work={work.slug}
        data-work-transition-context="detail"
        data-work-transition-part="title"
      >
        {work.title}
      </h1><p class="work-author">
        by <span
          data-work-transition-work={work.slug}
          data-work-transition-context="detail"
          data-work-transition-part="author"
        >
          {
            workAuthors.map((author, index) => (
              <Fragment>
                {index > 0 &&
                  (index === workAuthors.length - 1 ? (index === 1 ? ' and ' : ', and ') : ', ')}
                <a
                  href={url(`/authors/${author.slug}/`)}
                  data-author-transition-context="byline"
                  data-author-transition-parts="name"
                  data-author-transition-author={author.slug}
                  data-author-transition-part="name"
                >
                  {author.name}
                </a>
              </Fragment>
            ))
          }
        </span>
      </p>
    </header>
    <div class="work-reading-layout">
      <div class="work-body">
        {
          work.artworks.map((art) => (
            <figure class="work-art">
              <>
                <img
                  src={url(art.image)}
                  alt={art.alt}
                  width={art.width}
                  height={art.height}
                  loading="lazy"
                />
                <figcaption>{art.caption}</figcaption>
              </>
            </figure>
          ))
        }
        {
          work.recordings.length > 0 && (
            <section class="audio-section" id="listen" aria-label="Audio recordings">
              {work.recordings.map((recording) => (
                <div class="audio-card">
                  <div class="audio-card-title">
                    <Icon name="headphones" />
                    <h2>{recording.title}</h2>
                  </div>
                  {recording.description && <p>{recording.description}</p>}
                  <audio controls preload="none" aria-label={recording.title}>
                    <source src={url(recording.file)} type="audio/mpeg" />
                    <a href={url(recording.file)}>Download recording</a>
                  </audio>
                  <a class="audio-download" href={url(recording.file)} download>
                    Download MP3
                  </a>
                </div>
              ))}
            </section>
          )
        }
        {
          work.body &&
            (isPoetry(work.category) ? (
              work.bodyFormat === 'markdown' ? (
                <div
                  class="poem"
                  style={{ textAlign: work.poetryAlignment }}
                  set:html={poetry(work.body)}
                />
              ) : (
                <div class="poem" style={{ textAlign: work.poetryAlignment }}>
                  {work.body}
                </div>
              )
            ) : (
              <div class="prose" set:html={prose(work.body)} />
            ))
        }
      </div>
      <aside class="work-margin" aria-label="About this work and its contributors">
        {
          work.about && (
            <section class="work-note" aria-labelledby="work-note-title">
              <h2 class="eyebrow" id="work-note-title">
                About the work
              </h2>
              <div class="prose" set:html={prose(work.about)} />
            </section>
          )
        }
        <section class="work-author-note" aria-labelledby="work-author-title">
          <h2 class="eyebrow" id="work-author-title">
            {workAuthors.length > 1 ? 'About the authors' : 'About the author'}
          </h2>
          {
            workAuthors.map((author) => (
              <a
                class="author-teaser"
                href={url(`/authors/${author.slug}/`)}
                data-author-transition-context="teaser"
                data-author-transition-parts="portrait name"
              >
                {author.portrait ? (
                  <img
                    src={url(author.portraitSources?.[0]?.src || author.portrait)}
                    srcset={imageSrcset(author.portraitSources)}
                    sizes="3.5rem"
                    alt=""
                    loading="lazy"
                    data-author-transition-author={author.slug}
                    data-author-transition-context="teaser"
                    data-author-transition-part="portrait"
                  />
                ) : (
                  <span
                    class="avatar-letter"
                    aria-hidden="true"
                    data-author-transition-author={author.slug}
                    data-author-transition-context="teaser"
                    data-author-transition-part="portrait"
                  >
                    {initials(author.name)}
                  </span>
                )}
                <div>
                  <h3
                    data-author-transition-author={author.slug}
                    data-author-transition-context="teaser"
                    data-author-transition-part="name"
                  >
                    {author.name}
                  </h3>
                  <span class="text-link">
                    Meet the author <Icon name="arrow" size={16} />
                  </span>
                </div>
              </a>
            ))
          }
        </section>
        {
          moreByAuthors.map(({ author, works: authorWorks }) => (
            <section class="more-by-author" aria-labelledby={`more-by-${author.slug}`}>
              <h2 class="eyebrow" id={`more-by-${author.slug}`}>
                More by {author.name}
              </h2>
              <ul>
                {authorWorks.map((authorWork) => (
                  <li>
                    <a
                      href={url(`/works/${authorWork.slug}/`)}
                      data-work-transition={authorWork.slug}
                      data-work-transition-context="more-by"
                    >
                      <span>{authorWork.title}</span>
                      <Icon name="arrow" size={14} />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
        {
          work.pdfPage && (
            <a class="text-link work-pdf-link" href={readerUrl(work.issue, work.pdfPage)}>
              Read in issue <Icon name="arrow" size={15} />
            </a>
          )
        }
      </aside>
    </div>
  </main></Site
>
