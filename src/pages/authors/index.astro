---
import Site from '../../layouts/Site.astro';
import Icon from '../../components/Icon.astro';
import { authors, works, initials, url, imageSrcset } from '../../lib/content';
import '../../styles/authors.css';

const alphabet = new Intl.Collator('en', { sensitivity: 'base', numeric: true });
const list = [...authors].sort((a, b) => alphabet.compare(a.name.trim(), b.name.trim()));
---

<Site title="Authors">
  <main id="main" class="site-main">
    <section class="author-directory" aria-labelledby="authors-title" data-author-directory>
      <div class="section-heading author-directory-heading">
        <div>
          <span class="eyebrow">Voices of The Tempest</span>
          <h1 id="authors-title">All authors</h1>
        </div>
        <div class="author-directory-tools">
          <form class="author-search" role="search" aria-label="Author directory" hidden>
            <div class="author-search-field">
              <Icon name="search" size={24} />
              <input
                type="search"
                name="q"
                placeholder="Search authors"
                aria-label="Search authors"
                aria-controls="author-directory-results"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
              />
              <button class="author-search-clear" type="button" aria-label="Clear search" hidden>
                <Icon name="close" size={18} />
              </button>
            </div>
          </form>
          <span class="archive-count" role="status" aria-live="polite" aria-atomic="true"
            >{list.length} {list.length === 1 ? 'author' : 'authors'}</span
          >
        </div>
      </div>
      {
        list.length ? (
          <ul class="author-directory-grid" id="author-directory-results">
            {list.map((author) => {
              const contributions = works.filter((work) =>
                work.authors.includes(author.slug),
              ).length;
              return (
                <li data-author-name={author.name}>
                  <a
                    class="author-directory-card"
                    href={url(`/authors/${author.slug}/`)}
                    data-author-transition-context="card"
                    data-author-transition-parts="portrait name"
                  >
                    <div
                      class="directory-portrait"
                      data-author-transition-author={author.slug}
                      data-author-transition-context="card"
                      data-author-transition-part="portrait"
                    >
                      {author.portrait ? (
                        <img
                          src={url(author.portraitSources?.[0]?.src || author.portrait)}
                          srcset={imageSrcset(author.portraitSources)}
                          sizes="(max-width: 720px) calc((100vw - 3rem) / 2), (max-width: 960px) calc((100vw - 6rem) / 3), (max-width: 1180px) calc((100vw - 7.5rem) / 4), (min-width: 1500px) calc((100vw - 13.5rem) / 6), calc((100vw - 10.5rem) / 4)"
                          alt=""
                          loading="lazy"
                          width="400"
                          height="500"
                        />
                      ) : (
                        <span aria-hidden="true">{initials(author.name)}</span>
                      )}
                    </div>
                    <div class="directory-name">
                      <h3
                        data-author-transition-author={author.slug}
                        data-author-transition-context="card"
                        data-author-transition-part="name"
                      >
                        {author.name}
                      </h3>
                      <Icon name="arrow" />
                    </div>
                    <p class="directory-meta eyebrow muted">
                      {contributions
                        ? `${contributions} ${contributions === 1 ? 'work' : 'works'}`
                        : null}
                    </p>
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="empty-note">Author profiles will appear here as they are published.</p>
        )
      }
      <p class="author-search-empty empty-note" hidden>No authors found. Try another name.</p>
    </section>
  </main>
</Site>

<script>
  import '../../scripts/author-search';
</script>
