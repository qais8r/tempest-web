---
import Site from '../../layouts/Site.astro';
import WorkCard from '../../components/WorkCard.astro';
import { authors, works, prose, initials, url, imageSrcset } from '../../lib/content';
export function getStaticPaths() {
  return authors.map((author) => ({ params: { slug: author.slug }, props: { author } }));
}
const { author } = Astro.props;
const list = works.filter((w) => w.authors.includes(author.slug));
---

<Site title={author.name}
  ><main id="main" class="site-main author-page">
    <a
      class="breadcrumb"
      href={url('/authors/')}
      data-author-transition-context="profile"
      data-author-transition-parts="portrait name">← All authors</a
    ><section class="author-profile">
      <div
        class="author-portrait"
        data-author-transition-author={author.slug}
        data-author-transition-context="profile"
        data-author-transition-part="portrait"
      >
        {
          author.portrait ? (
            <img
              src={url(author.portraitSources?.[0]?.src || author.portrait)}
              srcset={imageSrcset(author.portraitSources)}
              sizes="(max-width: 720px) min(22rem, calc(100vw - 2rem)), 32vw"
              alt={author.name}
            />
          ) : (
            <span>{initials(author.name)}</span>
          )
        }
      </div><div>
        <span class="eyebrow accent">A voice in The Tempest</span><h1
          data-author-transition-author={author.slug}
          data-author-transition-context="profile"
          data-author-transition-part="name"
        >
          {author.name}
        </h1><div class="prose" set:html={prose(author.bio)} />
      </div>
    </section>{
      list.length > 0 && (
        <section class="author-works">
          <>
            <div class="section-heading">
              <h2>Selected contributions</h2>
            </div>
            <div class="work-grid">
              {list.map((work) => (
                <WorkCard work={work} />
              ))}
            </div>
          </>
        </section>
      )
    }
  </main></Site
>
