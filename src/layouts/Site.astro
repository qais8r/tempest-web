---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '../styles/global.css';
import { site, url, preview } from '../lib/content';
import Masthead from '../components/Masthead.astro';
import ViewTransitions from '../components/ViewTransitions.astro';
interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  reader?: boolean;
}
const { title, description = site.description, home = false, reader = false } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en" id={home ? 'top' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={reader ? '#191a19' : '#f4f0e6'} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{title ? `${title} · The Tempest` : 'The Tempest · Creative Arts at Mayo Clinic'}</title>
    <ViewTransitions root={url('/')} />
  </head>
  <body class:list={[reader ? 'reader-body' : 'paper', { 'home-page': home }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    {!reader && <Masthead home={home} />}
    <slot />
    {
      !reader && (
        <footer class="site-footer">
          <div class="footer-reflection">
            <>
              <div class="school-lockup">
                <>
                  <img
                    class="school-logo"
                    draggable="false"
                    src={url('/mayo-clinic-shields.svg')}
                    alt="Mayo Clinic shields"
                    width="367"
                    height="277"
                  />
                  <div>
                    <>
                      <strong>Mayo Clinic</strong>
                      <span>Alix School of Medicine</span>
                    </>
                  </div>
                </>
              </div>
              <img
                class="footer-tree"
                draggable="false"
                src={url('/footer-botanical.svg')}
                alt=""
                aria-hidden="true"
                width="240"
                height="250"
                loading="lazy"
              />
              <p>
                {site.tagline.split(/\r?\n/).map((line, index) => (
                  <Fragment>
                    {index > 0 && (
                      <>
                        <br />{' '}
                      </>
                    )}
                    {line}
                  </Fragment>
                ))}
              </p>
            </>
          </div>
          <div class="footer-bottom">
            <>
              <span>© {currentYear} The Tempest</span>
              <span>Designed by Qaisar Sulaiman</span>
            </>
          </div>
        </footer>
      )
    }
  </body>
</html>
